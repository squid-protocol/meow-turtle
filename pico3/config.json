{
    "system": {
        "device_id": 3,
        "role": "DISTRIBUTOR",
        "version": "1.11"
    },
    "app": {
        "stack_size": 8192,
        "boot_grace_ms": 3000,
        "life_refill_ms": 30000,
        "gc_panic_threshold": 50000
    },
    "comms": {
        "uart_bus": 0,
        "baud_rate": 115200,
        "tx_pin": 0,
        "rx_pin": 1,
        "max_retries": 5
    },
    "tuning": {
        "reply_delay_ms": 1,
        "debounce_ms": 10,
        "stall_timeout_ms": 500,
        "heartbeat_timeout_ms": 500
    },
    "actuators": [
        {
            "id": "CONVEYOR",
            "type": "BLDC",
            "pin": 21,
            "dir_pin": 20,
            "invert_dir": false,
            "min_duty": 0.05,
            "ramp_ms": 1000,
            "failsafe_val": 0.0,
            "verification": {
                "strategy": "TACHOMETER",
                "sensor_id": "pulse_count",
                "threshold": 10,
                "settle_ms": 1000,
                "quiet_ms": 3000
            }
        },
        { "id": "SOL_1", "type": "SOLENOID", "pin": 8, "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "SOL_2", "type": "SOLENOID", "pin": 9, "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "SOL_3", "type": "SOLENOID", "pin": 12, "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "SOL_4", "type": "SOLENOID", "pin": 13, "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "SOL_5", "type": "SOLENOID", "pin": 14, "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "SOL_6", "type": "SOLENOID", "pin": 15, "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "SOL_7", "type": "SOLENOID", "pin": 16, "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "SOL_8", "type": "SOLENOID", "pin": 17, "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "SOL_9", "type": "SOLENOID", "pin": 18, "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "SOL_10", "type": "SOLENOID", "pin": 19, "failsafe_val": 0.0, "max_on_ms": 1000 }
    ],
    "sensors": {
        "pulse_counters": [
            {
                "id": "pulse_count",
                "sm_id": 0,
                "pin": 22,
                "mirror_pin": 4
            }
        ],
        "digital_inputs": [
            {
                "id": "ESTOP_BUTTON",
                "pin": 26,
                "invert": true,
                "debounce_ms": 50
            }
        ]
    },
    "testing": {
        "watchdog_enabled": true,
        "share_actuator_events": false,
        "log_traffic": false,
        "debug_parser": false,
        "health_print_interval_ms": 0,
        "sensor_print_interval_ms": 0,
        "actuator_print_interval_ms": 250,
        "debug_stream_ms": 0
    }
}