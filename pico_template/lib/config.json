{
    "system": {
        "device_id": 3,
        "role": "DISTRIBUTOR",
        "version": "1.9_DEBUG"
    },
    "app": {
        "stack_size": 8192,
        "boot_grace_ms": 3000,
        "life_refill_ms": 30000,
        "gc_panic_threshold": 50000
    },
    "comms": {
        "uart_bus": 0,
        "baud_rate": 115200,
        "tx_pin": 0,
        "rx_pin": 1
    },
    "tuning": {
        "reply_delay_ms": 15,
        "debounce_ms": 10,
        "stall_timeout_ms": 500,
        "heartbeat_timeout_ms": 500
    },
    "actuators": [
        {
            "id": "conveyor",
            "type": "BLDC",
            "pin": 21,
            "dir_pin": 20,
            "invert_dir": false,
            "min_duty": 0.05,
            "ramp_ms": 1000,
            "failsafe_val": 0.0
        },
        { "id": "sol1", "pin": 8, "type": "SOLENOID", "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "sol2", "pin": 9, "type": "SOLENOID", "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "sol3", "pin": 12, "type": "SOLENOID", "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "sol4", "pin": 13, "type": "SOLENOID", "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "sol5", "pin": 14, "type": "SOLENOID", "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "sol6", "pin": 15, "type": "SOLENOID", "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "sol7", "pin": 16, "type": "SOLENOID", "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "sol8", "pin": 17, "type": "SOLENOID", "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "sol9", "pin": 18, "type": "SOLENOID", "failsafe_val": 0.0, "max_on_ms": 1000 },
        { "id": "sol10", "pin": 19, "type": "SOLENOID", "failsafe_val": 0.0, "max_on_ms": 1000 }
    ],
    "sensors": {
        "pulse_counters": [
            { "id": "conveyor_tach", "pin": 22, "sm_id": 0 }
        ], 
        "digital_inputs": [
            {
                "id": "ESTOP_BUTTON",
                "pin": 26,
                "invert": true,
                "debounce_ms": 50
            }
        ]
    },
    "testing": {
        "watchdog_enabled": true,
        "share_actuator_events": true,
        "log_traffic": true, 
        "debug_parser": true,
        "health_print_interval_ms": 1000,
        "sensor_print_interval_ms": 1000,
        "actuator_print_interval_ms": 1000,
        "debug_stream_ms": 1000
    }
}
